map $auth_user $agent_runtime_admin_upstream {
    ~^(${THOR_ADMIN_EMAILS_REGEX})$ "${THOR_AGENT_UPSTREAM}";
    default "http://127.0.0.1:8080/__opencode_admin_forbidden";
}

map $auth_user $admin_admin_upstream {
    ~^(${THOR_ADMIN_EMAILS_REGEX})$ "http://admin:3005";
    default "http://127.0.0.1:8080/__opencode_admin_forbidden";
}

map $auth_user $codex_lb_admin_upstream {
    ~^(${THOR_ADMIN_EMAILS_REGEX})$ "http://codex-lb:2455";
    default "http://127.0.0.1:8080/__opencode_admin_forbidden";
}

server {
    listen 8080;

    # Re-resolve upstream DNS on every request (Docker embedded DNS).
    resolver 127.0.0.11 valid=5s;

    # Vouch Proxy endpoints (unauthenticated). Host is forwarded so vouch
    # sees the public hostname; it suffix-matches r.Host against the JWT
    # `sites` claim (sourced from VOUCH_DOMAINS) on /validate.
    location /vouch/ {
        set $vouch http://vouch:9090;
        proxy_pass $vouch;
        proxy_set_header Host $http_host;
    }

    # Internal auth subrequest — called by auth_request
    location = /vouch/validate {
        internal;
        set $vouch http://vouch:9090;
        proxy_pass $vouch;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $http_host;
    }

    location = /__opencode_admin_forbidden {
        return 403;
    }

    # On 401 → redirect to Vouch login
    error_page 401 = @error401;
    location @error401 {
        return 302 http://$http_host/vouch/login?url=$scheme://$http_host$uri;
    }

    # Google Workspace account connection. The link is private and single-use;
    # Vouch independently verifies the browser email before Google authorization.
    location = /google-workspace/connect {
        access_log off;
        error_log /dev/null emerg;
        proxy_set_header X-Thor-Internal-Secret "${THOR_INTERNAL_SECRET}";

        set $remote_cli http://remote-cli:3004;
        proxy_pass $remote_cli;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location = /google-workspace/connect/authorize {
        access_log off;
        error_log /dev/null emerg;
        auth_request /vouch/validate;
        error_page 401 = @google_workspace_connect_login;

        auth_request_set $auth_user $upstream_http_x_vouch_user;
        proxy_set_header X-Vouch-User $auth_user;
        proxy_set_header X-Thor-Internal-Secret "${THOR_INTERNAL_SECRET}";

        set $remote_cli http://remote-cli:3004;
        proxy_pass $remote_cli;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location = /google-workspace/disconnect {
        access_log off;
        error_log /dev/null emerg;
        auth_request /vouch/validate;
        error_page 401 = @google_workspace_connect_login;

        auth_request_set $auth_user $upstream_http_x_vouch_user;
        proxy_set_header X-Vouch-User $auth_user;
        proxy_set_header X-Thor-Internal-Secret "${THOR_INTERNAL_SECRET}";

        set $remote_cli http://remote-cli:3004;
        proxy_pass $remote_cli;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location @google_workspace_connect_login {
        access_log off;
        error_log /dev/null emerg;
        return 302 ${GOOGLE_WORKSPACE_OAUTH_PUBLIC_BASE_URL}/vouch/login?url=${GOOGLE_WORKSPACE_OAUTH_PUBLIC_BASE_URL}$request_uri;
    }

    # Google returns through a public exact path. Remote-cli requires the
    # single-use state plus same-browser cookie and ingress-owned internal header.
    location = /google-workspace/oauth/callback {
        access_log off;
        error_log /dev/null emerg;
        proxy_set_header X-Thor-Internal-Secret "${THOR_INTERNAL_SECRET}";

        set $remote_cli http://remote-cli:3004;
        proxy_pass $remote_cli;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # Slack webhooks — no auth required
    location /slack/ {
        set $gateway http://gateway:3002;
        proxy_pass $gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # GitHub webhooks — no auth required
    location /github/ {
        set $gateway http://gateway:3002;
        proxy_pass $gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # Gateway health check — no auth required
    location = /health {
        set $gateway http://gateway:3002;
        proxy_pass $gateway/health;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # OpenCode and codex-lb both serve Vite assets. Try codex-lb first because
    # it returns a real 404 for unknown assets; OpenCode's SPA fallback does not.
    location /assets/ {
        set $codex_lb http://codex-lb:2455;
        proxy_pass $codex_lb;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_intercept_errors on;
        error_page 404 = @opencode_assets;
    }

    location @opencode_assets {
        internal;
        set $opencode ${THOR_AGENT_UPSTREAM};
        proxy_pass $opencode;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # Fixed public Slack activity artwork; no directory/prefix auth bypass.
    location = /neo-thinking-v1.gif { root /usr/share/nginx/thor-brand; try_files /neo-thinking-v1.gif =404; }
    location = /neo-working-v1.gif  { root /usr/share/nginx/thor-brand; try_files /neo-working-v1.gif =404; }
    location = /neo-ai-still-v1.png { root /usr/share/nginx/thor-brand; try_files /neo-ai-still-v1.png =404; }

    # Neo-branded icons / manifest / social-share — served from local files
    # to override OpenCode's defaults. Listed individually so unknown paths
    # still fall through to opencode.
    location = /favicon-96x96-v4.png   { root /usr/share/nginx/thor-brand; try_files /favicon-96x96-v4.png =404; }
    location = /favicon-v4.svg         { root /usr/share/nginx/thor-brand; try_files /favicon-v4.svg =404; }
    location = /favicon-v4.ico         { root /usr/share/nginx/thor-brand; try_files /favicon-v4.ico =404; }
    location = /apple-touch-icon-v4.png { root /usr/share/nginx/thor-brand; try_files /apple-touch-icon-v4.png =404; }
    location = /web-app-manifest-192x192-v4.png { root /usr/share/nginx/thor-brand; try_files /web-app-manifest-192x192-v4.png =404; }
    location = /web-app-manifest-512x512-v4.png { root /usr/share/nginx/thor-brand; try_files /web-app-manifest-512x512-v4.png =404; }
    location = /favicon-96x96-v3.png   { root /usr/share/nginx/thor-brand; try_files /favicon-96x96-v3.png =404; }
    location = /favicon-v3.svg         { root /usr/share/nginx/thor-brand; try_files /favicon-v3.svg =404; }
    location = /favicon-v3.ico         { root /usr/share/nginx/thor-brand; try_files /favicon-v3.ico =404; }
    location = /apple-touch-icon-v3.png { root /usr/share/nginx/thor-brand; try_files /apple-touch-icon-v3.png =404; }
    location = /web-app-manifest-192x192.png { root /usr/share/nginx/thor-brand; try_files /web-app-manifest-192x192.png =404; }
    location = /web-app-manifest-512x512.png { root /usr/share/nginx/thor-brand; try_files /web-app-manifest-512x512.png =404; }
    location = /social-share.png       { root /usr/share/nginx/thor-brand; try_files /social-share.png =404; }
    location = /site.webmanifest {
        root /usr/share/nginx/thor-brand;
        default_type application/manifest+json;
        try_files /site.webmanifest =404;
    }

    location = /oc-theme-preload.js {
        set $opencode ${THOR_AGENT_UPSTREAM};
        proxy_pass $opencode;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # Health check — no auth required
    location = /global/health {
        set $opencode ${THOR_AGENT_UPSTREAM};
        proxy_pass $opencode;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # Admin UI — protected by Google SSO and admin email, forwards X-Vouch-User
    location /admin/ {
        auth_request /vouch/validate;

        auth_request_set $auth_user $upstream_http_x_vouch_user;
        proxy_set_header X-Vouch-User $auth_user;

        proxy_pass $admin_admin_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # codex-lb dashboard — protected by Google SSO and admin email. Match only
    # codex-lb's dashboard API prefixes; OpenCode also owns routes under /api/.
    location ~ ^/(dashboard|accounts|settings|api/(accounts|api-keys|automations|conversation-archive|dashboard|dashboard-auth|firewall|model-sources|models|oauth|quota-planner|reports|request-logs|runtime|settings|sticky-sessions))(/|$) {
        auth_request /vouch/validate;

        auth_request_set $auth_user $upstream_http_x_vouch_user;
        proxy_set_header X-Vouch-User $auth_user;

        proxy_pass $codex_lb_admin_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # Runner-owned internal tooling routes — protected by Google SSO.
    location /runner/ {
        auth_request /vouch/validate;

        auth_request_set $auth_user $upstream_http_x_vouch_user;
        proxy_set_header X-Vouch-User $auth_user;

        set $runner http://runner:3000;
        proxy_pass $runner;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # All other OpenCode routes — protected by Google SSO and OpenCode admin email.
    location / {
        auth_request /vouch/validate;

        auth_request_set $auth_user $upstream_http_x_vouch_user;
        proxy_set_header X-Vouch-User $auth_user;

        proxy_pass $agent_runtime_admin_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # Rewrite the OpenCode title in the served HTML so the browser tab
        # reads "Neo". sub_filter only runs on text/html responses; the
        # SPA bundle is served from /assets/ and is unaffected.
        proxy_set_header Accept-Encoding "";
        sub_filter_once on;
        sub_filter "<title>OpenCode</title>" "<title>Neo</title>";
    }
}
