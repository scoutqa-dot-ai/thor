{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",
  "agent": {
    "explore": { "model": "openai/gpt-5.6-luna" },
    "general": {
      "model": "openai/gpt-5.6-sol",
      "options": { "reasoningEffort": "high" }
    }
  },
  "provider": {
    "openai": {
      "options": {
        "baseURL": "{env:CODEX_LB_BASE_URL}",
        "apiKey": "codex-lb-local"
      },
      "whitelist": ["gpt-5.6-luna", "gpt-5.6-sol", "gpt-5.6-terra"],
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6-Sol",
          "reasoning": true,
          "options": { "reasoningEffort": "medium", "reasoningSummary": "detailed" },
          "limit": { "context": 272000, "output": 65536 }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6-Terra",
          "reasoning": true,
          "options": { "reasoningEffort": "medium", "reasoningSummary": "detailed" },
          "limit": { "context": 272000, "output": 65536 }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6-Luna",
          "reasoning": true,
          "options": { "reasoningEffort": "low", "reasoningSummary": "detailed" },
          "limit": { "context": 272000, "output": 65536 }
        }
      }
    }
  },
  "permission": "allow",
  "plugin": ["./plugins/thor.js"],
  "mcp": {}
}
