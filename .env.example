# Environment variables required for Neo
# Copy this file to .env and fill in the values.
# Note: base URL vars (RUNNER_BASE_URL, GRAFANA_URL, FALCON_BASE_URL,
# LANGFUSE_HOST, METABASE_URL, DRATA_API_BASE_URL, KALI_API_BASE_URL,
# GITHUB_API_URL, SLACK_API_BASE_URL, etc.) must NOT have a trailing slash.

# ── CRON — shared secret for scheduled job auth ──────────────────────────────
CRON_SECRET=generate-a-random-secret

# ── INTERNAL — shared secret for gateway↔remote-cli internal APIs ───────────
THOR_INTERNAL_SECRET=generate-a-random-secret
# Test-only runner helper endpoints. Leave unset outside deterministic e2e runs.
# THOR_E2E_TEST_HELPERS=1
# Optional live Jira assignee e2e. Requires ATLASSIAN_AUTH plus a Jira user
# email in THOR_E2E_JIRA_EMAIL that resolves in the target cloud. The create
# call uses hard-coded fake project/type values and is expected to fail after
# attribution is injected.
# JIRA_CLOUD_ID=00000000-0000-0000-0000-000000000000
# THOR_E2E_JIRA_EMAIL=atlassian-user@example.com

# ── RUNNER — public base URL for Neo trigger viewer links ──────────────────
# Used by remote-cli when it appends "View trigger" links to PR/Jira text.
# Local ingress default:
RUNNER_BASE_URL=http://localhost:8080

# ── PI — opt-in embedded Durable runner ────────────────────────────────────
# Use docker-compose.pi.yml alongside docker-compose.yml (see docs/pi-runtime.md).
# The override selects Pi; the default deployment remains OpenCode.
# THOR_RUNTIME=opencode
# PI_EXECUTOR_URL=http://pi-executor:3002
# PI_STORAGE_PATH=/var/lib/runner/pi.sqlite
# PI_MODEL_BASE_URL=http://codex-lb:2455/v1
# PI_MODEL_ID=gpt-5.4
# PI_MODEL_API_KEY=codex-lb-local
# PI_MODEL_CONTEXT_WINDOW=272000
# PI_MODEL_SUPPORTS_IMAGES=true # Set false only for a text-only custom Responses backend.
# PI_SKILLS_DIR=/etc/thor/skills
# PI_MEMORY_DIR=/workspace/memory

# ── MITMPROXY — explicit outbound proxy for opencode clients ─────────────────
# Request path: opencode -> HTTP(S)_PROXY -> mitmproxy -> upstream.
# Routing is explicit through proxy env vars; there is no transparent intercept
# or firewall-level enforcement in this setup.
#
# Supported outbound clients for this workflow are:
#   - curl
#   - Node 22 built-in fetch()
#
# Put host rules in docker-volumes/workspace/config/thor.json under `mitmproxy[]`
# and `mitmproxy_passthrough[]`. Keep secrets in .env and reference them from
# thor.json via ${ENV_VAR} placeholders.
#
# Built-in defaults:
#   - inject Atlassian Authorization from ATLASSIAN_AUTH
#   - inject Slack Authorization Bearer token from SLACK_BOT_TOKEN
#   - passthrough OpenAI + ChatGPT domains without credential injection
#
# Example custom secret vars used by thor.json rules:
# BILLING_API_KEY=sk-your-api-key
# INTERNAL_API_TOKEN=your-internal-token

# ── GRAFANA — service account token for Loki/Tempo queries ─────────────────
GRAFANA_URL=https://your-instance.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Optional — defaults to 1. Set to target a specific Grafana org.
GRAFANA_ORG_ID=1

# ── FALCON — CrowdStrike Falcon MCP investigation access ───────────────────
# Create an API client with scopes for the enabled read-only modules.
# Credentials are mounted into the falcon-mcp service only; opencode receives
# only the controlled `mcp` wrapper through remote-cli.
FALCON_CLIENT_ID=*********************************
FALCON_CLIENT_SECRET=*********************************
FALCON_BASE_URL=https://api.crowdstrike.com
# Optional child CID for Flight Control / MSSP deployments.
# FALCON_MEMBER_CID=*********************************
# Optional comma-separated module list. Defaults in compose to read-only
# investigation modules: detections,hosts,intel,spotlight.
# FALCON_MCP_MODULES=detections,hosts,intel,spotlight

# ── ATLASSIAN — Atlassian MCP authorization header value ───────────────────
# Supports two authentication methods:
#
# 1. Service account API key (Bearer auth, recommended):
#    ATLASSIAN_AUTH=Bearer ATSTT3x_YOUR_SERVICE_ACCOUNT_API_KEY
#
# 2. Personal API token (Basic auth):
#    Generate: echo -n "you@example.com:ATATT3x_YOUR_SCOPED_TOKEN" | base64
#    ATLASSIAN_AUTH=Basic base64_encoded_email_colon_token
#
# See: https://support.atlassian.com/atlassian-rovo-mcp-server/docs/configuring-authentication-via-api-token/
ATLASSIAN_AUTH=Bearer YOUR_TOKEN_HERE

# ── LANGFUSE — LLM observability (read-only trace queries) ──────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-XXXXXXXXXXXXXXXXXXXXXXXXXXXX
LANGFUSE_SECRET_KEY=sk-lf-XXXXXXXXXXXXXXXXXXXXXXXXXXXX
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ── LAUNCHDARKLY — read-only feature flag inspection via ldcli ─────────────
# Create a Reader-scoped access token in LaunchDarkly:
# https://app.launchdarkly.com/settings/authorization/access-tokens
# LD_ACCESS_TOKEN=api-XXXXXXXXXXXXXXXXXXXXXXXXXXXX
# LD_BASE_URI=https://app.launchdarkly.com
# LD_PROJECT=default
# LD_ENVIRONMENT=production

# ── GITHUB — GitHub App auth for git/gh in remote-cli ───────────────────────
# App identity and webhook verification are env-only.
# Per-owner installation IDs go in /workspace/config/thor.json under:
#   owners.<owner>.github_app_installation_id
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=thor
GITHUB_APP_BOT_ID=49699333
GITHUB_APP_PRIVATE_KEY_FILE=/var/lib/remote-cli/github-app/private-key.pem
GITHUB_WEBHOOK_SECRET=replace-with-random-secret
# GITHUB_API_URL=https://api.github.com

# ── POSTHOG — personal API key (use the "MCP Server" preset) ────────────────
POSTHOG_API_KEY=phx_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── METABASE — data warehouse query access (read-only) ──────────────────────
# API key must be scoped to a read-only database role.
# METABASE_URL=https://metabase.example.com
# METABASE_API_KEY=mb_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
# METABASE_DATABASE_ID=41
# METABASE_ALLOWED_SCHEMAS=dm_products,dm_growth,dm_revenue

# ── DRATA — OAuth client credentials for API-managed read/write access ─────
# Create a Drata OAuth Application and copy these values from its token request
# details. The client secret is provided to remote-cli only. Configure scopes
# for intended operations: the wrapper has no method/API-version allowlist.
# DRATA_OAUTH_TOKEN_URL=https://<auth-domain>/oauth/token
# DRATA_CLIENT_ID=*********************************
# DRATA_CLIENT_SECRET=*********************************
# DRATA_AUDIENCE=*********************************
# DRATA_SCOPES=read:example
# DRATA_API_BASE_URL=https://<api-url>

# ── KALI MCP — EC2-hosted Kali API server for authorized security testing ───
# Run `kali-server-mcp --ip 0.0.0.0` on the Kali EC2 host and restrict network
# access to trusted Neo infrastructure (security group, VPN, or SSH tunnel).
# The URL points at the Kali API server, not a Streamable HTTP MCP endpoint.
# KALI_API_BASE_URL=http://kali-ec2.example:5000

# ── GOOGLE WORKSPACE — per-Slack-user OAuth broker ─────────────────────────
# Onboarding sends the trusted Slack requester a private DM; no Slack profile
# email/email-read permission is needed. Enable the Slack app's Messages Tab.
# SLACK_TEAM_ID is required; google_workspace_email is an optional account pin.
# Create a Google Web OAuth client. Register exactly:
#   https://<thor-host>/google-workspace/oauth/callback
# These values are provided only to remote-cli, never OpenCode or gws.
# GOOGLE_WORKSPACE_OAUTH_CLIENT_ID=*********************************************
# GOOGLE_WORKSPACE_OAUTH_CLIENT_SECRET=*********************************
# Exact HTTPS origin with no path or trailing slash.
# GOOGLE_WORKSPACE_OAUTH_PUBLIC_BASE_URL=https://****************
# Fixed allowlisted Drive, Docs, and Sheets scopes only.
# GOOGLE_WORKSPACE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive,https://www.googleapis.com/auth/documents,https://www.googleapis.com/auth/spreadsheets
# Generate a dedicated 32-byte base64 key, for example: openssl rand -base64 32
# Back up and rotate it as a credential; losing it invalidates stored grants.
# GOOGLE_WORKSPACE_OAUTH_ENCRYPTION_KEY=********************************************
# Optional project header passed to gws. No credential file or global fallback.
# GOOGLE_WORKSPACE_PROJECT_ID=**************


# ── 1PASSWORD BROWSER — approval-gated local browser login ─────────────────
# Do NOT assign OP_SERVICE_ACCOUNT_TOKEN in this file. Inject it only into the
# remote-cli service through the deployment secret store (or export it only in
# the shell that starts Compose for a local one-off test). See
# docs/onepassword-browser.md.
# ONEPASSWORD_BROWSER_VAULT_ID=aaaaaaaaaaaaaaaaaaaaaaaaaa

# ── DAYTONA — cloud sandboxes for Python/Java/etc. ──────────────────────────
# See docs/daytona.md for setup instructions.
# DAYTONA_API_KEY=daytona_XXXXXXXXXXXX
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_SNAPSHOT=thor-sandbox  # optional; defaults to daytona-medium

# ── SLACK — remote-cli posting, bot token, and webhook verification ──────────
# Create a Slack app with Events API subscription and bot scopes for the Slack
# surfaces Neo uses: `app_mentions:read`, `chat:write`, `canvases:write`,
# and any read/reaction/file scopes needed by your workflows. The same bot token
# is used by remote-cli for controlled slack-post-message calls, by gateway for
# Slack Web API calls, and by mitmproxy for supported Slack
# read/reaction/canvas/upload auth injection.
SLACK_BOT_TOKEN=
# Optional Slack Web API base URL. Defaults to https://slack.com/api.
# SLACK_API_BASE_URL=https://slack.com/api
SLACK_BOT_USER_ID=
SLACK_SIGNING_SECRET=
# Required repo directory name used for every Slack channel unless a per-channel
# override at /workspace/memory/thor/repo-by-slack-channel/<channel-id>.txt
# names a different repo directory. The value must name an existing directory
# under /workspace/repos before `docker compose up`.
SLACK_DEFAULT_REPO=your-repo
# Optional channel used by live Slack e2e scripts.
# SLACK_E2E_CHANNEL_ID=C0123456789
# SLACK_TIMESTAMP_TOLERANCE_SECONDS=300
# Optional Slack workspace team id. When set, the admin sessions dashboard
# and the runner trigger viewer render Slack thread chips and source links as
# clickable permalinks. Find it in any Slack URL:
# https://app.slack.com/client/<TEAM_ID>/...
# SLACK_TEAM_ID=T01234567

# ── VOUCH — Google SSO for ingress auth ──────────────────────────────────────
VOUCH_GOOGLE_CLIENT_ID=your-google-client-id
VOUCH_GOOGLE_CLIENT_SECRET=your-google-client-secret
VOUCH_JWT_SECRET=generate-a-random-secret
# Google-authenticated users from these email domains may use domain-scoped
# routes. Vouch matches exact domains and subdomains from the email address.
VOUCH_ALLOWED_EMAIL_DOMAINS=scoutqa.cc
# OpenCode-backed ingress routes and /admin/ require one of these exact
# authenticated emails (comma-separated).
THOR_ADMIN_EMAILS=admin@scoutqa.cc,owner@scoutqa.cc
# VOUCH_CALLBACK_URL=http://localhost:8080/vouch/auth
# VOUCH_COOKIE_DOMAIN=localhost
